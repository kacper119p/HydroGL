#version 460

#include "TriangleProperties.glsl"
#include "Water/WaterCommon.glsl"

layout(std140, binding = 0) uniform meshData
{
    mat4 ObjectToWorldMatrix;
    uint VerticesIndex;
    uint IndicesIndex;
    uint TrianglesIndex;
    uint TrianglesCount;

} MeshData;

layout(std430, binding = 0) readonly buffer CascadeSettingsBuffer
{
    int TextureResolution;
    int CascadeCount;
    float padding[2];
    cascadeSettings CascadeSettings[];
};

layout(std430, binding = 1) writeonly buffer TrianglePropertiesBuffer
{
    triangleProperties TriangleProperties[];
};

layout(std430, binding = 2) readonly buffer VertexBuffer
{
    vec3 VertexPositions[];
};

layout(std430, binding = 3) readonly buffer IndexBuffer
{
    uint VertexIndices[];
};


layout (binding = 3) uniform sampler2DArray DisplacementMaps;

const int WATER_HEIGHT_RETRIEVE_ITERATIONS = 4;

float RetrieveWaterHeight(vec2 position)
{
    vec3 displacement = vec3(0.0);
    for (int i = 0; i < WATER_HEIGHT_RETRIEVE_ITERATIONS; ++i)
    {
        vec2 shiftedPosition = position - displacement.xz;
        displacement = vec3(0.0);
        for (int cascade = 0; cascade < CascadeCount; ++cascade)
        {
            const vec2 texCoord = vec2(shiftedPosition.x, shiftedPosition.y) / CascadeSettings[cascade].Length;
            displacement += texture(DisplacementMaps, vec3(texCoord, cascade)).xyz;
        }
    }
    return displacement.y;
}

void ProcessTriangle(vec3 VertexPositionsWorldSpace[3], vec3 TriangleNormal, out float SubmergedArea, out float VolumeContribution, out float TriangleArea)
{
    float vertexDepths[3];
    for (int i = 0; i < 3; ++i)
    {
        vertexDepths[i] = VertexPositionsWorldSpace[i].y - RetrieveWaterHeight(VertexPositionsWorldSpace[i].xz);
    }

    TriangleArea = 0.5 * length(cross(VertexPositionsWorldSpace[1] - VertexPositionsWorldSpace[0], VertexPositionsWorldSpace[2] - VertexPositionsWorldSpace[0]));
    vec3 center = (1.0 / 3.0) * (VertexPositionsWorldSpace[0] + VertexPositionsWorldSpace[1] + VertexPositionsWorldSpace[2]);
    float centerDepth = (1.0 / 3.0) * (vertexDepths[0] + vertexDepths[1] + vertexDepths[2]);

    bvec3 trianglesAboveWater = greaterThanEqual(vec3(vertexDepths[0], vertexDepths[1], vertexDepths[2]), vec3(0.0));
    if (all(trianglesAboveWater))
    {
        SubmergedArea = 0.0;
        VolumeContribution = 0.0;
        return;
    }
    else if (all(not(trianglesAboveWater)))
    {
        SubmergedArea = TriangleArea;
        VolumeContribution = TriangleArea * centerDepth * TriangleNormal.y;
        return;
    }
    else
    {
        int aboveWaterCount = 0;
        int aboveWaterIndex = -1;

        for (int i = 0; i < 3; ++i)
        {
            if (trianglesAboveWater[i])
            {
                ++aboveWaterCount;
                aboveWaterIndex = i;
            }
        }

        if (aboveWaterCount == 1)
        {
            // One vertex above water, two underwater
            vec3 v0 = VertexPositionsWorldSpace[aboveWaterIndex];// above water vertex
            vec3 v1 = VertexPositionsWorldSpace[(aboveWaterIndex + 1) % 3];
            vec3 v2 = VertexPositionsWorldSpace[(aboveWaterIndex + 2) % 3];

            float d0 = vertexDepths[aboveWaterIndex];
            float d1 = vertexDepths[(aboveWaterIndex + 1) % 3];
            float d2 = vertexDepths[(aboveWaterIndex + 2) % 3];

            // Compute intersection points using linear interpolation
            float alpha1 = d0 / (d0 - d1);
            float alpha2 = d0 / (d0 - d2);
            vec3 p1 = v0 + alpha1 * (v1 - v0);
            vec3 p2 = v0 + alpha2 * (v2 - v0);

            // Create submerged sub-triangle p1-v0-p2
            SubmergedArea = 0.5 * length(cross(p1 - v0, p2 - v0));
            VolumeContribution = TriangleArea * centerDepth * TriangleNormal.y;
            return;
        }
        else
        {
            int underwaterIndex = -1;
            for (int i = 0; i < 3; ++i)
            {
                if (!trianglesAboveWater[i])
                {
                    underwaterIndex = i;
                }
            }
            vec3 v0 = VertexPositionsWorldSpace[underwaterIndex];// underwater vertex
            vec3 v1 = VertexPositionsWorldSpace[(underwaterIndex + 1) % 3];
            vec3 v2 = VertexPositionsWorldSpace[(underwaterIndex + 2) % 3];

            float d0 = vertexDepths[underwaterIndex];
            float d1 = vertexDepths[(underwaterIndex + 1) % 3];
            float d2 = vertexDepths[(underwaterIndex + 2) % 3];

            // Compute intersection points using linear interpolation
            float alpha1 = d0 / (d0 - d1);
            float alpha2 = d0 / (d0 - d2);
            vec3 p1 = v0 + alpha1 * (v1 - v0);
            vec3 p2 = v0 + alpha2 * (v2 - v0);

            // The submerged area is formed by two triangles: p1-v1-v2 and p1-v2-p2
            float areaTriangle1 = 0.5 * length(cross(v1 - p1, v2 - p1));
            float areaTriangle2 = 0.5 * length(cross(v2 - p1, p2 - p1));

            // Calculate centroids and depths for volume contribution
            vec3 centroid1 = (p1 + v1 + v2) / 3.0;
            vec3 centroid2 = (p1 + v2 + p2) / 3.0;

            float depth1 = vertexDepths[(aboveWaterIndex + 1) % 3] - centroid1.y;
            float depth2 = vertexDepths[(aboveWaterIndex + 2) % 3] - centroid2.y;

            SubmergedArea = areaTriangle1 + areaTriangle2;
            VolumeContribution = TriangleArea * centerDepth * TriangleNormal.y;
        }
    }
}

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main()
{
    const uint triangleIndex = gl_GlobalInvocationID.x;
    if (triangleIndex >= MeshData.TrianglesCount)
    {
        return;
    }

    uint index0 = VertexIndices[MeshData.IndicesIndex + triangleIndex * 3];
    uint index1 = VertexIndices[MeshData.IndicesIndex + triangleIndex * 3 + 1];
    uint index2 = VertexIndices[MeshData.IndicesIndex + triangleIndex * 3 + 2];

    vec3 vertexPositionsWorldSpace[3];
    vertexPositionsWorldSpace[0] = (MeshData.ObjectToWorldMatrix * vec4(VertexPositions[MeshData.VerticesIndex + index0], 1.0)).xyz;
    vertexPositionsWorldSpace[1] = (MeshData.ObjectToWorldMatrix * vec4(VertexPositions[MeshData.VerticesIndex + index1], 1.0)).xyz;
    vertexPositionsWorldSpace[2] = (MeshData.ObjectToWorldMatrix * vec4(VertexPositions[MeshData.VerticesIndex + index2], 1.0)).xyz;

    vec3 triangleNormal = normalize(cross(vertexPositionsWorldSpace[1] - vertexPositionsWorldSpace[0], vertexPositionsWorldSpace[2] - vertexPositionsWorldSpace[0]));

    float submergedArea;
    float volumeContribution;
    float triangleArea;
    ProcessTriangle(vertexPositionsWorldSpace, triangleNormal, submergedArea, volumeContribution, triangleArea);

    TriangleProperties[triangleIndex].SubmergedArea = submergedArea;
    TriangleProperties[triangleIndex].SubmergedVolume = volumeContribution;
    TriangleProperties[triangleIndex].Drag = vec3(0.0);
}
