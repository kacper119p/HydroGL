#version 460

#include "TriangleProperties.glsl"
#include "Water/WaterCommon.glsl"
#include "Constants.glsl"

layout(std140, binding = 0) uniform meshDataBuffer
{
    mat4 ObjectToWorldMatrix;
    vec3 ObjectVelocity;
    float DragCoefficient;
    uint VerticesIndex;
    uint IndicesIndex;
    uint TrianglesCount;
} MeshData;

uniform vec2 WindVelocity;

layout(std430, binding = 0) readonly restrict buffer CascadeSettingsBuffer
{
    int TextureResolution;
    int CascadeCount;
    int VelocityLayers;
    float VelocityMinHeight;
    float VelocityMaxHeight;
    float Padding[3];
    cascadeSettings CascadeSettings[];
};

layout(std430, binding = 1) writeonly restrict buffer TrianglePropertiesBuffer
{
    triangleProperties TriangleProperties[];
};

layout(std430, binding = 2) readonly restrict buffer VertexBuffer
{
    float VertexPositions[];
};

layout(std430, binding = 3) readonly restrict buffer IndexBuffer
{
    uint VertexIndices[];
};


layout (binding = 0) uniform sampler2DArray DisplacementMaps;
layout (binding = 1) uniform sampler2DArray Velocity;

const int WATER_HEIGHT_RETRIEVE_ITERATIONS = 4;
const float WATER_DENSITY = 1024.8103;
const float AIR_DENSITY = 1.204;

float RetrieveWaterHeight(vec2 position)
{
    vec3 displacement = vec3(0.0);
    for (int i = 0; i < WATER_HEIGHT_RETRIEVE_ITERATIONS; ++i)
    {
        vec2 shiftedPosition = position - displacement.xz;
        displacement = vec3(0.0);
        for (int cascade = 0; cascade < CascadeCount; ++cascade)
        {
            const vec2 texCoord = vec2(shiftedPosition.x, shiftedPosition.y) / CascadeSettings[cascade].Length;
            displacement += texture(DisplacementMaps, vec3(texCoord, cascade)).xyz;
        }
    }
    return displacement.y;
}

float Remap(float value, float inMin, float inMax, float outMin, float outMax)
{
    return outMin + (value - inMin) * (outMax - outMin) / (inMax - inMin);
}

vec3 RetrieveWaterVelocity(vec3 position)
{
    vec3 velocity = vec3(0.0);
    for (int cascade = 0; cascade < CascadeCount; ++cascade)
    {
        const int velocityBaseIndex = cascade * VelocityLayers;
        float textureIndex = velocityBaseIndex + Remap(position.y, VelocityMinHeight, VelocityMaxHeight, 0.0, float(VelocityLayers - 1));
        textureIndex = clamp(textureIndex, velocityBaseIndex, velocityBaseIndex + VelocityLayers - 1);

        const float lowerIndex = floor(textureIndex);
        const float upperIndex = ceil(textureIndex);
        const float t = textureIndex - lowerIndex;

        const vec2 texCoord = vec2(position.x, position.z) / CascadeSettings[cascade].Length;

        const vec3 lowerValue = texture(Velocity, vec3(texCoord, lowerIndex)).xyz;
        const vec3 upperValue = texture(Velocity, vec3(texCoord, upperIndex)).xyz;

        velocity += mix(lowerValue, upperValue, t);
    }
    return velocity;
}

void ProcessTriangle(vec3 VertexPositionsWorldSpace[3], const float TriangleNormalY, out float TriangleArea, out float SubmergedArea, out float VolumeContribution, out float TriangleDepth)
{
    float vertexDepths[3];
    for (int i = 0; i < 3; ++i)
    {
        vertexDepths[i] = VertexPositionsWorldSpace[i].y - RetrieveWaterHeight(VertexPositionsWorldSpace[i].xz);
    }

    TriangleDepth = (1.0 / 3.0) * (vertexDepths[0] + vertexDepths[1] + vertexDepths[2]);
    TriangleArea = 0.5 * length(cross(VertexPositionsWorldSpace[1] - VertexPositionsWorldSpace[0], VertexPositionsWorldSpace[2] - VertexPositionsWorldSpace[0]));

    bvec3 verticesAboveWater = greaterThanEqual(vec3(vertexDepths[0], vertexDepths[1], vertexDepths[2]), vec3(EPSILON));
    if (all(verticesAboveWater))
    {
        SubmergedArea = 0.0;
        VolumeContribution = 0.0;
        return;
    }
    else if (all(not(verticesAboveWater)))
    {
        SubmergedArea = TriangleArea;
        VolumeContribution = TriangleArea * TriangleDepth * TriangleNormalY;
        return;
    }
    else
    {
        int aboveWaterCount = 0;
        int aboveWaterIndex = -1;

        for (int i = 0; i < 3; ++i)
        {
            if (verticesAboveWater[i])
            {
                ++aboveWaterCount;
                aboveWaterIndex = i;
            }
        }

        if (aboveWaterCount == 1)
        {
            // One vertex above water, two underwater
            vec3 v0 = VertexPositionsWorldSpace[aboveWaterIndex];// above water vertex
            vec3 v1 = VertexPositionsWorldSpace[(aboveWaterIndex + 1) % 3];
            vec3 v2 = VertexPositionsWorldSpace[(aboveWaterIndex + 2) % 3];

            float d0 = vertexDepths[aboveWaterIndex];
            float d1 = vertexDepths[(aboveWaterIndex + 1) % 3];
            float d2 = vertexDepths[(aboveWaterIndex + 2) % 3];

            // Compute intersection points using linear interpolation
            float alpha1 = d0 / (d0 - d1);
            float alpha2 = d0 / (d0 - d2);
            vec3 p1 = v0 + alpha1 * (v1 - v0);
            vec3 p2 = v0 + alpha2 * (v2 - v0);

            // The submerged area is formed by two triangles: p1-v1-v2 and p1-v2-p2
            float areaTriangle1 = 0.5 * length(cross(v1 - p1, v2 - p1));
            float areaTriangle2 = 0.5 * length(cross(v2 - p1, p2 - p1));

            // Create submerged sub-triangle p1-v0-p2
            SubmergedArea = areaTriangle1 + areaTriangle2;
            VolumeContribution = SubmergedArea * TriangleDepth * TriangleNormalY;
            return;
        }
        else //if(aboveWaterCount == 2)
        {
            int underwaterIndex = -1;
            for (int i = 0; i < 3; ++i)
            {
                if (!verticesAboveWater[i])
                {
                    underwaterIndex = i;
                }
            }
            vec3 v0 = VertexPositionsWorldSpace[underwaterIndex];// underwater vertex
            vec3 v1 = VertexPositionsWorldSpace[(underwaterIndex + 1) % 3];
            vec3 v2 = VertexPositionsWorldSpace[(underwaterIndex + 2) % 3];

            float d0 = vertexDepths[underwaterIndex];
            float d1 = vertexDepths[(underwaterIndex + 1) % 3];
            float d2 = vertexDepths[(underwaterIndex + 2) % 3];

            // Compute intersection points using linear interpolation
            float alpha1 = d0 / (d0 - d1);
            float alpha2 = d0 / (d0 - d2);
            vec3 p1 = v0 + alpha1 * (v1 - v0);
            vec3 p2 = v0 + alpha2 * (v2 - v0);

            // The submerged area is formed by sub-triangle v0-p1-p2
            SubmergedArea= 0.5 * length(cross(v0 - p1, v0 - p2));

            VolumeContribution = SubmergedArea * TriangleDepth * TriangleNormalY;
        }
    }
}

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main()
{
    const uint triangleIndex = gl_GlobalInvocationID.x;
    if (triangleIndex >= MeshData.TrianglesCount)
    {
        return;
    }

    uint index0 = VertexIndices[MeshData.IndicesIndex + triangleIndex * 3];
    uint index1 = VertexIndices[MeshData.IndicesIndex + triangleIndex * 3 + 1];
    uint index2 = VertexIndices[MeshData.IndicesIndex + triangleIndex * 3 + 2];

    uint vertexTrueIndices[3];
    vertexTrueIndices[0] = (MeshData.VerticesIndex + index0) * 3;
    vertexTrueIndices[1] = (MeshData.VerticesIndex + index1) * 3;
    vertexTrueIndices[2] = (MeshData.VerticesIndex + index2) * 3;

    vec3 vertexObjectSpacePositions[3];
    vertexObjectSpacePositions[0] = vec3(VertexPositions[vertexTrueIndices[0]], VertexPositions[vertexTrueIndices[0] + 1], VertexPositions[vertexTrueIndices[0] + 2]);
    vertexObjectSpacePositions[1] = vec3(VertexPositions[vertexTrueIndices[1]], VertexPositions[vertexTrueIndices[1] + 1], VertexPositions[vertexTrueIndices[1] + 2]);
    vertexObjectSpacePositions[2] = vec3(VertexPositions[vertexTrueIndices[2]], VertexPositions[vertexTrueIndices[2] + 1], VertexPositions[vertexTrueIndices[2] + 2]);

    vec3 vertexPositionsWorldSpace[3];
    vertexPositionsWorldSpace[0] = (MeshData.ObjectToWorldMatrix * vec4(vertexObjectSpacePositions[0], 1.0)).xyz;
    vertexPositionsWorldSpace[1] = (MeshData.ObjectToWorldMatrix * vec4(vertexObjectSpacePositions[1], 1.0)).xyz;
    vertexPositionsWorldSpace[2] = (MeshData.ObjectToWorldMatrix * vec4(vertexObjectSpacePositions[2], 1.0)).xyz;

    vec3 triangleNormal = normalize(cross(vertexPositionsWorldSpace[1] - vertexPositionsWorldSpace[0], vertexPositionsWorldSpace[2] - vertexPositionsWorldSpace[0]));
    float triangleArea;
    float submergedArea;
    float volumeContribution;
    float triangleDepth;
    ProcessTriangle(vertexPositionsWorldSpace, triangleNormal.y, triangleArea, submergedArea, volumeContribution, triangleDepth);

    const vec3 triangleCenter = (1.0 / 3.0) * (vertexObjectSpacePositions[0] + vertexObjectSpacePositions[1] + vertexObjectSpacePositions[2]);
    const vec3 triangleCenterWS = (1.0 / 3.0) * (vertexPositionsWorldSpace[0] + vertexPositionsWorldSpace[1] + vertexPositionsWorldSpace[2]);

    const vec3 waterVelocity = RetrieveWaterVelocity(vec3(triangleCenterWS.x, triangleDepth, triangleCenterWS.z));
    const vec3 relativeWaterVelocity = MeshData.ObjectVelocity - waterVelocity;
    const float relativeWaterSpeed = max(EPSILON, length(relativeWaterVelocity));
    const float waterProjectedArea = clamp(dot(triangleNormal, relativeWaterVelocity / relativeWaterSpeed), 0.0, 1.0) * submergedArea;
    const vec3 WaterDrag = -0.5 * MeshData.DragCoefficient * WATER_DENSITY * waterProjectedArea * relativeWaterSpeed * relativeWaterVelocity;

    const vec3 windVelocity = vec3(WindVelocity.x, 0.0, WindVelocity.y);
    const vec3 relativeWindVelocity = windVelocity - MeshData.ObjectVelocity;
    const float relativeWindSpeed = max(EPSILON, length(relativeWindVelocity));
    const float windProjectedArea = clamp(dot(triangleNormal, relativeWindVelocity / relativeWindSpeed), 0.0, 1.0) * submergedArea;
    const vec3 AirDrag = -0.5 * MeshData.DragCoefficient * AIR_DENSITY * windProjectedArea * relativeWindSpeed * relativeWindVelocity;

    TriangleProperties[triangleIndex].Drag = WaterDrag + AirDrag;
    TriangleProperties[triangleIndex].SubmergedArea = submergedArea;
    TriangleProperties[triangleIndex].CenterOfImmersion = triangleCenter * triangleCenter * triangleNormal * submergedArea * 0.5;
    TriangleProperties[triangleIndex].SubmergedVolume = volumeContribution;
}
