#version 460 core

uniform float OceanSize;
layout (binding = 0, rgba32f) uniform image2D HDx;
layout (binding = 1, rgba32f) uniform image2D DzDfhx;
layout (binding = 2, rgba32f) uniform image2D DfhzDfdxx;
layout (binding = 3, rgba32f) uniform image2D DfdzxDfdzz;
layout (binding = 4, rgba32f) writeonly uniform image2D NormalTexture;
layout (binding = 5, rgba32f) writeonly uniform image2D DisplacementTexture;

layout (local_size_x = 16, local_size_y = 16) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const float phaseChange = (((pixelCoords.x + pixelCoords.y) % 2)) * 2.0 - 1.0;

    const vec2 dxdy = imageLoad(HDx, pixelCoords).br / OceanSize;
    const vec2 dzdfhxx = imageLoad(DzDfhx, pixelCoords).rb / OceanSize;
    const float dfhz = imageLoad(DfhzDfdxx, pixelCoords).r / OceanSize;

    const vec3 displacement = vec3(dxdy.x, dxdy.y, dzdfhxx.r) * phaseChange;
    const vec3 normal = normalize(vec3(-dzdfhxx.y, phaseChange, -dfhz)) * phaseChange;

    imageStore(NormalTexture, pixelCoords, vec4(normal, 1.0f));
    imageStore(DisplacementTexture, pixelCoords, vec4(displacement, 1.0f));
}
