#version 460 core

#include "WaterCommon.glsl"

layout (binding = 0, rgba32f) uniform image2DArray HDx;
layout (binding = 1, rgba32f) uniform image2DArray DzDfhx;
layout (binding = 2, rgba32f) uniform image2DArray DfhzDfdxx;
layout (binding = 3, rgba32f) uniform image2DArray DfdzxDfdzz;
layout (binding = 4, rgba32f) writeonly uniform image2DArray NormalTexture;
layout (binding = 5, rgba32f) writeonly uniform image2DArray DisplacementTexture;

layout(std430, binding = 0) buffer CascadeSettingsBuffer
{
    int TextureResolution;
    int CascadeCount;
    float padding[2];
    cascadeSettings CascadeSettings[];
};

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const float phaseChange = (((pixelCoords.x + pixelCoords.y) % 2)) * 2.0 - 1.0;
    int cascadeIndex = int(gl_GlobalInvocationID.z);

    const ivec3 sampleCoords = ivec3(pixelCoords, cascadeIndex);
    const float cascadeLength = CascadeSettings[cascadeIndex].Length;

    const vec2 dxdy = imageLoad(HDx, sampleCoords).br / TextureResolution;
    const vec2 dzdfhxx = imageLoad(DzDfhx, sampleCoords).rb / TextureResolution;
    const float dfhz = imageLoad(DfhzDfdxx, sampleCoords).r / TextureResolution;

    const vec3 displacement = vec3(dxdy.x, dxdy.y, dzdfhxx.x) * phaseChange;
    const vec3 normal = normalize(vec3(-dzdfhxx.y, phaseChange, -dfhz)) * phaseChange;

    imageStore(NormalTexture, sampleCoords, vec4(normal, 1.0f));
    imageStore(DisplacementTexture, sampleCoords, vec4(displacement, 1.0f));
}
