#version 460 core
#include "Constants.glsl"
#include "WaterInteractionStructs.glsl"

layout(std140, binding = 0) uniform shaderUniforms
{
    mat2 VelocitySpaceTransform;
    vec2 ObjectWorldPosition;
    vec2 BoundBoxMin;
    vec2 BoundBoxMax;
    float IntersectionMaskPhysicalSize;
    float DisplacementStrength;
    float Hf;
    float Hb;
} ShaderUniforms;

layout (binding = 0, r32f) uniform writeonly restrict image2D Output;

layout(std430, binding = 0) readonly restrict buffer intersectionBuffer
{
    int Count;
    intersectionSegment IntersectionSegments[];
} IntersectionBuffer;

bool CheckRaySegmentIntersection(vec2 RayOrigin, vec2 P0, vec2 P1)
{
    float dy = P1.y - P0.y;
    if (abs(dy) < EPSILON)
    {
        return false;
    }
    float t1 = (RayOrigin.y - P0.y) / dy;
    if (t1 <= 0.0 || t1 >= 1.0)
    {
        return false;
    }
    float t2 = P0.x + t1 * (P1.x - P0.x);
    return t2 >= RayOrigin.x;
}

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 textureResolution = imageSize(Output);
    const ivec2 textureCenter = ivec2(textureResolution >> 1);
    const ivec2 centeredPixelCoords = pixelCoords - textureCenter;

    const vec2 localSpacePosition = (vec2(centeredPixelCoords) / vec2(textureResolution)) * ShaderUniforms.IntersectionMaskPhysicalSize;
    const vec2 worldSpacePosition = localSpacePosition + ShaderUniforms.ObjectWorldPosition;

    bool isInside = false;

    for (int i = 0; i < IntersectionBuffer.Count; ++i)
    {
        if (CheckRaySegmentIntersection(worldSpacePosition, IntersectionBuffer.IntersectionSegments[i].P0, IntersectionBuffer.IntersectionSegments[i].P1))
        {
            isInside = !isInside;
        }
    }

    if (!isInside)
    {
        imageStore(Output, pixelCoords, vec4(0.0));
        return;
    }

    const vec2 velocitySpacePosition = ShaderUniforms.VelocitySpaceTransform * localSpacePosition;
    const vec2 objectPositionVelocitySpace = ShaderUniforms.VelocitySpaceTransform * (ShaderUniforms.ObjectWorldPosition - ShaderUniforms.ObjectWorldPosition);

    const vec2 boundsMinVelocitySpace = ShaderUniforms.VelocitySpaceTransform * (ShaderUniforms.BoundBoxMin - ShaderUniforms.ObjectWorldPosition);
    const vec2 boundsMaxVelocitySpace = ShaderUniforms.VelocitySpaceTransform * (ShaderUniforms.BoundBoxMax - ShaderUniforms.ObjectWorldPosition);

    const vec2 boundsSizeVelocitySpace = abs(boundsMaxVelocitySpace - boundsMinVelocitySpace);

    const float f = abs(velocitySpacePosition.x) / boundsSizeVelocitySpace.x;

    const float zMin = min(boundsMinVelocitySpace.y, boundsMaxVelocitySpace.y);
    const float zMax = max(boundsMinVelocitySpace.y, boundsMaxVelocitySpace.y);

    const float a = (ShaderUniforms.Hf - ShaderUniforms.Hb) / (zMax - zMin);
    const float b = ShaderUniforms.Hb - a * zMin;
    const float g = a * velocitySpacePosition.y + b;

    imageStore(Output, pixelCoords, vec4(ShaderUniforms.DisplacementStrength * (f + g)));
}
