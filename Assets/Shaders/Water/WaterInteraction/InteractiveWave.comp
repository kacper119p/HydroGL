#version 460 core

layout(std140, binding = 0) uniform shaderUniforms
{
    vec2 PreviousObjectWorldPosition0;
    vec2 PreviousObjectWorldPosition1;
    vec2 CurrentObjectWorldPosition;
    float PreviousInteractiveWavesFieldSize0;
    float PreviousInteractiveWavesFieldSize1;
    float CurrentInteractiveWavesFieldSize;
    float MaskFieldSize;
    float WaveDampingFactor;
    float AWaveFactor;
    float DisplacementStrength;
} ShaderUniforms;

layout(binding = 0) uniform sampler2D DisplacementMask;
layout(binding = 1) uniform sampler2D PreviousFrameWaves0;
layout(binding = 2) uniform sampler2D PreviousFrameWaves1;
layout(binding = 3, r32f) writeonly restrict uniform image2D OutputWaves;

float calculateEdgeFade(const vec2 uv) {
    const float margin = 0.1;
    const vec2 distanceToEdge = min(uv, 1.0 - uv);
    const vec2 fade = clamp(distanceToEdge / margin, 0.0, 1.0);
    return fade.x * fade.y;
}

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 textureResolution = imageSize(OutputWaves);
    const ivec2 textureCenter = ivec2(textureResolution >> 1);
    const ivec2 centeredPixelCoords = pixelCoords - textureCenter;

    const float previousDelta0 = float(textureResolution.x) / ShaderUniforms.PreviousInteractiveWavesFieldSize0;
    const float previousDelta1 = float(textureResolution.x) / ShaderUniforms.PreviousInteractiveWavesFieldSize1;
    const float currentDelta = float(textureResolution.x) / ShaderUniforms.CurrentInteractiveWavesFieldSize;

    const float scaleRatio0 = ShaderUniforms.CurrentInteractiveWavesFieldSize / ShaderUniforms.PreviousInteractiveWavesFieldSize0;
    const float scaleRatio1 = ShaderUniforms.CurrentInteractiveWavesFieldSize / ShaderUniforms.PreviousInteractiveWavesFieldSize1;

    const vec2 worldOffsetPixels0 = (ShaderUniforms.CurrentObjectWorldPosition - ShaderUniforms.PreviousObjectWorldPosition0) * previousDelta0;
    const vec2 worldOffsetPixels1 = (ShaderUniforms.CurrentObjectWorldPosition - ShaderUniforms.PreviousObjectWorldPosition1) * previousDelta1;

    const vec2 previousSamplePosition0 = (vec2(centeredPixelCoords) * scaleRatio0 - worldOffsetPixels0 + vec2(textureCenter) + 0.5) / float(textureResolution);
    const vec2 previousSamplePosition1 = (vec2(centeredPixelCoords) * scaleRatio1 - worldOffsetPixels1 + vec2(textureCenter) + 0.5) / float(textureResolution);

    const vec2 dx = vec2(1.0 / float(textureResolution), 0.0);
    const vec2 dy = vec2(0.0, 1.0 / float(textureResolution));

    const float centerSample = texture(PreviousFrameWaves1, previousSamplePosition1).r;
    const float rightSample = texture(PreviousFrameWaves1, previousSamplePosition1 + dx).r;
    const float leftSample = texture(PreviousFrameWaves1, previousSamplePosition1 - dx).r;
    const float upSample = texture(PreviousFrameWaves1, previousSamplePosition1 + dy).r;
    const float downSample = texture(PreviousFrameWaves1, previousSamplePosition1 - dy).r;

    const float oldWaveSample = texture(PreviousFrameWaves0, previousSamplePosition0).r;

    const float laplacian = ShaderUniforms.AWaveFactor * (rightSample + leftSample + upSample + downSample - 4.0 * centerSample);
    const float waveHeight = ShaderUniforms.WaveDampingFactor * (laplacian + 2.0 * centerSample - oldWaveSample);

    const vec2 uv = vec2(pixelCoords) / vec2(textureResolution);
    const float edgeFade = calculateEdgeFade(uv);

    const vec2 currentLocalPosition = vec2(centeredPixelCoords) / currentDelta;
    const vec2 maskTexCoord = (-currentLocalPosition) / ShaderUniforms.MaskFieldSize + 0.5;
    const float maskDisplacement = texture(DisplacementMask, maskTexCoord).r;

    imageStore(OutputWaves, pixelCoords, vec4(waveHeight * edgeFade + maskDisplacement));
}
