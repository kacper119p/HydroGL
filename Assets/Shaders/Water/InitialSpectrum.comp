#version 460 core

#include "WaveSpectrum.glsl"

layout (binding = 0, rgba32f) writeonly uniform image2D Output;
layout (binding = 1, rg32f) readonly uniform image2D GaussianNoise;

uniform int TextureResolution;
uniform int CascadeSize;

layout (local_size_x = 16, local_size_y = 16) in;
void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    ivec2 textureCenter = ivec2(TextureResolution >> 1);
    ivec2 waveCoords = pixelCoords - textureCenter;
    vec2 waveVector = (2.f * PI * waveCoords) / CascadeSize;

    vec2 gaussSample = imageLoad(GaussianNoise, pixelCoords).rg;

    vec2 h0 = gaussSample * CalculateSpectrum(waveVector, CascadeSize);
    vec2 h0Star = gaussSample * CalculateSpectrum(-waveVector, CascadeSize);
    h0Star.y = -h0Star.y;

    imageStore(Output, pixelCoords, vec4(h0, h0Star));
}
