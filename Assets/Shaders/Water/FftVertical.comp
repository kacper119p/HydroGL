#version 460 core

#include "Complex.glsl"
#include "Constants.glsl"

layout (binding = 0, rgba32f) uniform readonly image2DArray Input;
layout (binding = 1, rgba32f) uniform writeonly image2DArray Output;

uniform int TotalCount;
uniform int subCount;

vec4 ButterflyOperation(vec2 a, vec2 b, vec2 twiddle)
{
    const vec2 twiddleB = ComplexProduct(twiddle, b);
    return vec4(a + twiddleB, a - twiddleB);
}

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.yx);
    const int layerId = int(gl_GlobalInvocationID.z);

    const int threadCount = int(TotalCount * 0.5f);
    const int threadIdx = pixelCoords.y;

    const int inIdx = threadIdx & (subCount - 1);
    const int outIdx = ((threadIdx - inIdx) << 1) + inIdx;

    const float angle = -PI * (float(inIdx) / float(subCount));
    const vec2 twiddle = Euler(angle);

    const vec4 a = imageLoad(Input, ivec3(pixelCoords.x, pixelCoords.y, layerId));
    const vec4 b = imageLoad(Input, ivec3(pixelCoords.x, pixelCoords.y + threadCount, layerId));

    const vec4 result0 = ButterflyOperation(a.xy, b.xy, twiddle);
    const vec4 result1 = ButterflyOperation(a.zw, b.zw, twiddle);

    imageStore(Output, ivec3(pixelCoords.x, outIdx, layerId), vec4(result0.xy, result1.xy));
    imageStore(Output, ivec3(pixelCoords.x, outIdx + subCount, layerId), vec4(result0.zw, result1.zw));
}
