#version 460 core

#include "Water/WaterCommon.glsl"

layout (binding = 1) uniform sampler2DArray SlopeTextures;
layout (binding = 2) uniform sampler2DArray DisplacementTextures;

layout(binding = 3, r32f) writeonly uniform image2DArray outputTextures;

DEFINE_CASCADE_SETTINGS_BUFFER(0);

DEFINE_FOAM_PARAMETERS_BUFFER(0);

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    int cascadeIndex = int(gl_GlobalInvocationID.z);
    vec2 texCoord = vec2(texelCoord) / vec2(imageSize(outputTextures));

    vec4 slopeDfdxxDfdzz =  texture(SlopeTextures, vec3(texCoord, cascadeIndex));
    float dfdzx = texture(DisplacementTextures, vec3(texCoord, cascadeIndex)).w;

    const float jacobian = (1.0 + slopeDfdxxDfdzz.z) * (1.0 + slopeDfdxxDfdzz.w) - dfdzx * dfdzx;
    float compression = clamp((FoamParameters.FoamThreshold - jacobian) / FoamParameters.FoamThreshold, 0.0, 1.0);
    float foamMask = clamp(FoamParameters.FoamIntensity * pow(compression, FoamParameters.FoamExponent), 0.0, 1.0);

    imageStore(outputTextures, ivec3(texelCoord, cascadeIndex), vec4(foamMask));
}
