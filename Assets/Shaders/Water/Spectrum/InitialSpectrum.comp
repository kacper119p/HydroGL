#version 460 core

#include "Water/WaterCommon.glsl"

layout (binding = 0, rgba32f) writeonly restrict uniform image2DArray Output;
layout (binding = 1, rg32f) readonly restrict uniform image2D GaussianNoise;

DEFINE_CASCADE_SETTINGS_BUFFER(0);

layout(std140, binding = 0) uniform spectrumParams
{
    vec2 WindVelocity;
    float Fetch;
    float Delta;
    float Swell;
    float Alpha;
    float PeakWaveFrequency;
    float _padding;
} SpectrumParams;

float calculateR(const float Omega)
{
    const float sigma = (Omega <= SpectrumParams.PeakWaveFrequency) ? 0.07 : 0.09;

    const float numerator = Omega - SpectrumParams.PeakWaveFrequency;
    const float denominator = -2.0 * sigma * sigma * SpectrumParams.PeakWaveFrequency * SpectrumParams.PeakWaveFrequency;

    return exp(numerator * numerator / denominator);
}

float CalcualteWindBias(const vec2 WaveVector, const vec2 WindVelocity)
{
    const float windBias = atan(WaveVector.y, WaveVector.x) - atan(SpectrumParams.WindVelocity.y, SpectrumParams.WindVelocity.x);

    if (windBias > PI)
    {
        return windBias - 2.0f * PI;
    }
    else if (windBias < -PI)
    {
        return windBias + 2.0f * PI;
    }
    return windBias;
}

float CalculateBeta(const float ROmega)
{
    if (ROmega < 0.95)
    {
        return 2.61 * pow(ROmega, 1.3);
    }
    if (ROmega < 1.6)
    {
        return 2.28 * pow(ROmega, -1.3);
    }
    const float epsilon = 0.8393 * exp (-0.567 * log(ROmega * ROmega)) - 0.4;
    return pow(10.0, epsilon);

}

float DonelanBannerDirectionalSpread(const float Beta, const float WindBias)
{
    const float qdb = 1.0 / tanh(Beta * PI);
    const float sech = 1.0 / cosh(Beta * WindBias);
    return 0.5 * qdb * Beta * sech * sech;
}

float CalculateSwellDirectionalSpread(const float WindBias, const float ROmega)
{
    return pow(abs(cos(WindBias / 2.0)), 32.0 * tanh(1.0 / ROmega) * SpectrumParams.Swell * SpectrumParams.Swell);
}

float Jonswap(const float omega)
{
    const float r = calculateR(omega);

    const float omega2 = omega * omega;
    const float omega5 = omega2 * omega2 * omega;

    const float omegaPByOmega = SpectrumParams.PeakWaveFrequency / omega;
    const float omegaPByOmega2 = omegaPByOmega * omegaPByOmega;
    const float omegaPByOmega4 = omegaPByOmega2 * omegaPByOmega2;

    return SpectrumParams.Alpha * G2 / omega5 * exp(-1.25 * omegaPByOmega4) * pow(GAMMA, r);
}

float GetSpreadValue(const float theta, const  float ROmega, const float Beta)
{
    return CalculateSwellDirectionalSpread(theta, ROmega) * DonelanBannerDirectionalSpread(Beta, theta);
}

float CalculateNormalizationFactor(const float ROmega, const  float Beta)
{
    // Uses Composite Simpson's 1/3 rule to approximate the integral
    const uint steps = 64;
    const float start = -PI;
    const float end = PI;

    const float stepSize = (end - start) / float(steps);

    float sum = GetSpreadValue(start, ROmega, Beta) + GetSpreadValue(end, ROmega, Beta);

    for (uint i = 1; i < steps; i += 2)
    {
        const float theta = start + float(i) * stepSize;
        sum += 4.0 * GetSpreadValue(theta, ROmega, Beta);
    }
    for (uint i = 2; i < steps; i += 2)
    {
        const float theta = start + float(i) * stepSize;
        sum += 2.0 * GetSpreadValue(theta, ROmega, Beta);
    }

    const float integral = max((stepSize / 3.0) * sum, EPSILON);
    return 1.0 / integral;
}

float DirectionalSpectrum(const vec2 WaveVector, const float Omega)
{
    const float rOmega = Omega / SpectrumParams.PeakWaveFrequency;
    const float windBias = CalcualteWindBias(WaveVector, SpectrumParams.WindVelocity);
    const float beta = CalculateBeta(rOmega);

    const float normalizationFactor = CalculateNormalizationFactor(rOmega, beta);
    const float donelanBannerSpread = DonelanBannerDirectionalSpread(beta, windBias);
    const float swellSpread = CalculateSwellDirectionalSpread(windBias, rOmega);

    const float finalSpectrum = donelanBannerSpread * swellSpread * normalizationFactor;

    return mix(1.0 / (2.0 * PI), finalSpectrum, SpectrumParams.Delta);
}

float CalculateInitialSpectrum(const vec2 WaveVector, const float K, const float CascadeLength, const float DeltaK)
{
    const float omega = CalculateDispersion(K);
    const float frequencySpectrum = Jonswap(omega);
    const float directionalSpectrum = DirectionalSpectrum(WaveVector, omega);
    const float OmegaDk = G / (2.0 * omega);
    return sqrt(max((0.5 * frequencySpectrum * directionalSpectrum) * DeltaK * DeltaK * OmegaDk / K, 0.0));
}

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const int cascadeIndex = int(gl_GlobalInvocationID.z);

    const float cascadeLength = float(CascadeSettingsBuffer.CascadeSettings[cascadeIndex].Length);

    const ivec2 textureCenter = ivec2(CascadeSettingsBuffer.TextureResolution >> 1);
    const ivec2 waveCoords = pixelCoords - textureCenter;
    const float deltaK = (2.0 * PI) / cascadeLength;
    const vec2 waveVector = vec2(waveCoords) * deltaK;
    const float k = length(waveVector);

    if (k < CascadeSettingsBuffer.CascadeSettings[cascadeIndex].WaveLengthLowerBound
    || k >= CascadeSettingsBuffer.CascadeSettings[cascadeIndex].WaveLengthUpperBound)
    {
        imageStore(Output, ivec3(pixelCoords, cascadeIndex), vec4(0.0));
        return;
    }

    const vec4 gaussSample = imageLoad(GaussianNoise, pixelCoords);
    const vec4 gaussSampleMirror = imageLoad(GaussianNoise, ivec2(CascadeSettingsBuffer.TextureResolution - pixelCoords));

    const vec2 h0 = gaussSample.rg * CalculateInitialSpectrum(waveVector, k, cascadeLength, deltaK);
    vec2 h0Star = gaussSampleMirror.rg * CalculateInitialSpectrum(-waveVector, k, cascadeLength, deltaK);
    h0Star.y = -h0Star.y;

    imageStore(Output, ivec3(pixelCoords, cascadeIndex), vec4(h0, h0Star));
}
