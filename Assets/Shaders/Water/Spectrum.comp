#version 460 core

#include "WaveSpectrum.glsl"

layout (binding = 0, rgba32f) uniform image2D HDx;
layout (binding = 1, rgba32f) uniform image2D DzDfhx;
layout (binding = 2, rgba32f) uniform image2D DfhzDfdxx;
layout (binding = 3, rgba32f) uniform image2D DfdzxDfdzz;
layout (binding = 4, rg32f) uniform image2D InitialSpectrum;

uniform int TextureResolution;
uniform int CascadeSize;
uniform float Time;

const float gamma = 3.3;
const float g = 9.80665;

vec2 ComplexProduct(const vec2 a, const vec2 b)
{
    return vec2(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x);
}

vec2 MultiplyByI(const vec2 x){
    return vec2(-x.y, x.x);
}

vec2 MultiplyByMinusI(const vec2 x){
    return vec2(x.y, -x.x);
}

vec2 Euler(const float x){
    return vec2(cos(x), sin(x));
}

layout (local_size_x = 16, local_size_y = 16) in;
void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    ivec2 textureCenter = ivec2(TextureResolution >> 1);
    ivec2 waveCoords = pixelCoords - textureCenter;
    vec2 waveVector = (2.f * PI * waveCoords) / CascadeSize;

    float k = length(waveVector);

    float phase = Dispersion(k) * Time;

    vec2 h0 = imageLoad(InitialSpectrum, pixelCoords).rg;
    vec2 h0Star = vec2(h0.x, -h0.y);

    vec2 h = ComplexProduct(h0, Euler(phase)) + ComplexProduct(h0Star, Euler(-phase));

    k = max(k, 0.00005);
    vec2 dx = MultiplyByI(h) / k * waveVector.x;
    vec2 dz = MultiplyByI(h) / k * waveVector.y;

    vec2 dfdxx = -MultiplyByMinusI(dx) * waveVector.x;
    vec2 dfdzx = -MultiplyByMinusI(dz) * waveVector.x;
    vec2 dfdzz = -MultiplyByMinusI(dz) * waveVector.y;

    vec2 dfhx = k * dx;
    vec2 dfhz = k * dz;

    imageStore(HDx, pixelCoords, vec4(h, dx));
    imageStore(DzDfhx, pixelCoords, vec4(dz, dfhx));
    imageStore(DfhzDfdxx, pixelCoords, vec4(dfhz, dfdxx));
    imageStore(DfdzxDfdzz, pixelCoords, vec4(dfdzx, dfdzz));
}
