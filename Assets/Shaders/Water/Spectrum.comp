#version 460 core

#include "WaterCommon.glsl"
#include "Complex.glsl"

layout (binding = 0, rgba32f) uniform image2DArray HDx;
layout (binding = 1, rgba32f) uniform image2DArray DzDfhx;
layout (binding = 2, rgba32f) uniform image2DArray DfhzDfdxx;
layout (binding = 3, rgba32f) uniform image2DArray DfdzxDfdzz;
layout (binding = 4, rgba32f) uniform image2DArray InitialSpectrum;

layout(std430, binding = 0) buffer CascadeSettingsBuffer
{
    int TextureResolution;
    int CascadeCount;
    float padding[2];
    cascadeSettings CascadeSettings[];
};

uniform float Time;

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const int cascadeIndex = int(gl_GlobalInvocationID.z);
    const ivec3 sampleCoords = ivec3(pixelCoords, cascadeIndex);

    const ivec2 textureCenter = ivec2(TextureResolution >> 1);
    const ivec2 waveCoords = pixelCoords - textureCenter;
    const vec2 waveVector = (2.f * PI * waveCoords) / CascadeSettings[cascadeIndex].Length;

    float k = length(waveVector);

    const float phase = CalculateDispersion(k) * Time;

    const vec4 initialSpectrum = imageLoad(InitialSpectrum, sampleCoords);
    const vec2 h0 = initialSpectrum.rg;
    const vec2 h0Star = initialSpectrum.ba;

    const vec2 h = ComplexProduct(h0, Euler(phase)) + ComplexProduct(h0Star, Euler(-phase));

    k = max(k, 0.00005);
    const vec2 dx = MultiplyByI(h) / k * waveVector.x;
    const vec2 dz = MultiplyByI(h) / k * waveVector.y;

    const vec2 dfdxx = -MultiplyByMinusI(dx) * waveVector.x;
    const vec2 dfdzx = -MultiplyByMinusI(dz) * waveVector.x;
    const vec2 dfdzz = -MultiplyByMinusI(dz) * waveVector.y;

    const vec2 dfhx = k * dx;
    const vec2 dfhz = k * dz;

    imageStore(HDx, sampleCoords, vec4(h, dx));
    imageStore(DzDfhx, sampleCoords, vec4(dz, dfhx));
    imageStore(DfhzDfdxx, sampleCoords, vec4(dfhz, dfdxx));
    imageStore(DfdzxDfdzz, sampleCoords, vec4(dfdzx, dfdzz));
}
