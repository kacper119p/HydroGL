#version 460 core

#include "WaterCommon.glsl"
#include "Complex.glsl"

layout (binding = 0, rgba32f) writeonly restrict uniform image2DArray HDzDxDfhx;
layout (binding = 1, rgba32f) writeonly restrict uniform image2DArray DfhzDfdxxDfdzxDfdzz;
layout (binding = 2, rgba32f) writeonly restrict uniform image2DArray VelocityPacked;
layout (binding = 3, rgba32f) readonly restrict uniform image2DArray InitialSpectrum;

layout(std430, binding = 0) readonly buffer CascadeSettingsBuffer
{
    int TextureResolution;
    int CascadeCount;
    int VelocityLayers;
    float VelocityMinHeight;
    float VelocityMaxHeight;
    float Padding[3];
    cascadeSettings CascadeSettings[];
};

uniform float Time;

vec2 PackIffts(vec2 a, vec2 b)
{
    return vec2(a.x - b.y, a.y + b.x);
}

float VelocityAttenuation(const float k, const float height)
{
    return height > 0.0 ? 1.0 + k * height : exp(k * height);
}

void GetVelocityVector(out vec2 vx, out vec2 vy, out vec2 vz, const vec2 hv, const float k, const float dispersion, const vec2 waveVector, const float height)
{
    const vec2 Eh = hv * VelocityAttenuation(k, height);
    vx = Eh * (-waveVector.x * G / dispersion);
    vy = vec2(-Eh.y * dispersion, Eh.x * dispersion);
    vz = Eh * (-waveVector.y * G / dispersion);
}
layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    const ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    const int cascadeIndex = int(gl_GlobalInvocationID.z);
    const ivec3 sampleCoords = ivec3(pixelCoords, cascadeIndex);

    const ivec2 textureCenter = ivec2(TextureResolution >> 1);
    const ivec2 waveCoords = pixelCoords - textureCenter;
    const vec2 waveVector = (2.f * PI * waveCoords) / CascadeSettings[cascadeIndex].Length;

    float k = length(waveVector);

    float dispersion = CalculateDispersion(k);
    const float phase = dispersion * Time;

    const vec4 initialSpectrum = imageLoad(InitialSpectrum, sampleCoords);
    const vec2 h0 = initialSpectrum.rg;
    const vec2 h0Star = initialSpectrum.ba;

    const vec2 ha = ComplexProduct(h0, Euler(phase));
    const vec2 hb = ComplexProduct(h0Star, Euler(-phase));
    const vec2 h =  ha + hb;

    k = max(k, EPSILON);
    const vec2 dx = MultiplyByI(h) / k * waveVector.x;
    const vec2 dz = MultiplyByI(h) / k * waveVector.y;

    const vec2 dfdxx = MultiplyByMinusI(dx) * waveVector.x;
    const vec2 dfdzx = MultiplyByMinusI(dz) * waveVector.x;
    const vec2 dfdzz = MultiplyByMinusI(dz) * waveVector.y;

    const vec2 dfhx = k * dx;
    const vec2 dfhz = k * dz;

    vec2 hDz =  PackIffts(h, dz);
    vec2 dxDfhx = PackIffts(dx, dfhx);
    vec2 dfhzDfdxx = PackIffts(dfhz, dfdxx);
    vec2 dfdzxDfdzz = PackIffts(dfdzx, dfdzz);

    imageStore(HDzDxDfhx, sampleCoords, vec4(hDz, dxDfhx));
    imageStore(DfhzDfdxxDfdzxDfdzz, sampleCoords, vec4(dfhzDfdxx, dfdzxDfdzz));

    const int velocityBaseIndex = cascadeIndex * VelocityLayers;

    const vec2 hv = ha - hb;

    dispersion = max(dispersion, EPSILON);
    for (int i = 0; i < VelocityLayers; ++i)
    {
        vec2 vx;
        vec2 vy;
        vec2 vz;
        const float height = mix(VelocityMinHeight, VelocityMaxHeight, float(i) / float(VelocityLayers - 1));
        GetVelocityVector(vx, vy, vz, hv, k, dispersion, waveVector, height);

        imageStore(VelocityPacked, ivec3(pixelCoords, velocityBaseIndex + i), vec4(PackIffts(vx, vy), vz));
    }
}
